{
  "name": "wsd-front-end",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@react-oauth/google": "^0.12.1",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/classnames": "^2.3.1",
    "@types/jest": "^27.5.2",
    "@types/leaflet": "1.9.12",
    "@types/leaflet-geosearch": "^3.0.0",
    "@types/node": "^16.18.97",
    "ag-charts-community": "^10.3.3",
    "ag-charts-react": "^10.3.3",
    "assert": "^2.1.0",
    "axios": "^1.8.2",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "constants-browserify": "^1.0.0",
    "dayjs": "^1.11.13",
    "framer-motion": "^11.3.21",
    "gsap": "^3.15.0",
    "imagemin": "^9.0.1",
    "imagemin-pngquant": "^9.0.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.0.0",
    "lucide-react": "^0.511.0",
    "matroska-subtitles": "^3.3.2",
    "moment": "^2.30.1",
    "multiselect-react-dropdown": "^2.0.25",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "plyr": "^3.7.8",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-app-rewired": "^2.2.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-input-mask": "^2.0.4",
    "react-intl": "^6.8.9",
    "react-laag": "^2.0.5",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^2.1.0",
    "react-paginate": "^8.2.0",
    "react-router-dom": "^6.23.1",
    "react-scripts": "^5.0.1",
    "react-select": "^5.8.0",
    "react-tailwindcss-datepicker": "^1.7.2",
    "react-youtube": "^10.1.0",
    "sharp": "^0.34.3",
    "stream-browserify": "^3.0.0",
    "tailwind-merge": "^3.3.0",
    "typescript": "^4.9.5",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "video.js": "^8.21.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start:development": "env-cmd -f .env.development react-app-rewired start",
    "build:production": "env-cmd -f .env.production CI=false react-app-rewired build",
    "start": "react-app-rewired start",
    "build": "GENERATE_SOURCEMAP=true CI=false react-app-rewired build",
    "pre-render": "node scripts/prerender.js",
    "test": "react-app-rewired test",
    "eject": "react-scripts eject",
    "lint": "eslint \"./src/**/*.{js,jsx,ts,tsx}\""
  },
  "reactSnap": {
    "inlineCss": false,
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true
    },
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage",
      "--disable-gpu",
      "--no-first-run",
      "--no-zygote",
      "--single-process"
    ],
    "include": [
      "/",
      "/videos",
      "/songs",
      "/subtitles",
      "/text-paste",
      "/dictionary",
      "/learning",
      "/subscribe",
      "/youtube-demo",
      "/songs-demo",
      "/texts-demo",
      "/subtitles-demo"
    ],
    "skipThirdPartyRequests": true,
    "cacheAjaxRequests": false,
    "preconnectThirdParty": true
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": "warn",
      "react-hooks/exhaustive-deps": "warn",
      "jsx-a11y/role-supports-aria-props": "warn",
      "jsx-a11y/iframe-has-title": "off",
      "jsx-a11y/heading-has-content": "off",
      "no-throw-literal": "warn",
      "no-useless-escape": "off",
      "no-useless-concat": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-private-property-in-object": "^7.24.7",
    "@eslint/js": "^9.9.1",
    "@types/jszip": "^3.4.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-input-mask": "^3.0.5",
    "env-cmd": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.2",
    "globals": "^15.9.0",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.4",
    "typescript-eslint": "^8.4.0"
  }
}
