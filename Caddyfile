substreamedu.com, www.substreamedu.com {
    # Automatic SSL is handled by Caddy by default

    # API Gateway Routing
    handle /api* {
        reverse_proxy gateway:8080 {
            transport http {
                read_timeout 100s
            }
        }
    }

    # Serve shared media files (Reels, TikToks)
    @mediaFiles path_regexp ^/videos/.*\.(mp4|mkv|webm|jpg|jpeg|png|gif|webp)$
    handle @mediaFiles {
        uri strip_prefix /videos
        root * /var/www/shared_media
        file_server
    }

    # Auth Service Routing
    handle /auth* {
        reverse_proxy gateway:8080
    }

    # Serve static files directly (Edge Serving)
    # Serve static files directly (Edge Serving)
    handle {
        root * /var/www/frontend
        encode gzip zstd

        # SPA Routing: Try file, then directory, then fallback to index.html
        try_files {path} {path}/ /index.html

        file_server
    }

    # Global Options/Headers
    # NOTE: CORS is handled by the Go gateway for /api/* routes.
    # Do NOT add Access-Control-Allow-Origin here — duplicate CORS
    # headers break Safari/iOS (all browsers on iPhone use WebKit).
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://www.youtube.com https://s.ytimg.com https://accounts.google.com https://apis.google.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob: https://i.ytimg.com; media-src 'self' blob: https:; connect-src 'self' wss: https: https://accounts.google.com https://cdn.jsdelivr.net blob: data:; worker-src 'self' blob:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://accounts.google.com;"
    }

    # Logging
    log {
        output file /var/log/caddy/access.log {
            roll_size 20MiB
            roll_keep 5
            roll_keep_for 14d
        }
    }
}
