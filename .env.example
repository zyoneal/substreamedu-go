# SubstreamEdu Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env with real values to git!

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# ===========================================
# IAM Service
# ===========================================
POSTGRES_DB_IAM=sse_iam
SECRET_KEY=your_jwt_secret_key_min_32_chars
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret

# Mail Configuration (for magic links)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# ===========================================
# Dictionary Service
# ===========================================
POSTGRES_DB_DICTIONARY=substreamedu_dictionary
DEEPSEEK_API_KEY=your_deepseek_api_key
GEMINI_API_KEY=your_gemini_api_key
PIXABAY_API_KEY=your_free_pixabay_key

# Deprecated: Noun Project v2 API is now paid, replaced by Hybrid Service
NOUN_PROJECT_API_KEY=your_noun_project_key
NOUN_PROJECT_API_SECRET=your_noun_project_secret

# ===========================================
# Media Service
# ===========================================
POSTGRES_DB_MEDIA=substreamedu_media
YOUTUBE_API_KEY=your_youtube_api_key
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SUBDL_API_KEY=your_subdl_api_key

# ===========================================
# Notification Service
# ===========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username

# ===========================================
# Infrastructure & Security
# ===========================================
REDIS_HOST=localhost
REDIS_PASSWORD=your_secure_redis_password_min_32_chars
# Shared secret for authenticating internal microservice-to-microservice HTTP requests
INTERNAL_SERVICE_KEY=your_internal_service_key_at_least_32_characters_long
# Comma-separated allowed origins for CORS (e.g. https://substreamedu.com,https://www.substreamedu.com)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80
# If using AWS Elasticache with Cluster Mode Disabled (Split Read/Write)
# REDIS_WRITE_HOST=master.redis.cache.amazonaws.com

